# --- Database (free Postgres, e.g. Supabase or Neon) ---
DATABASE_URL="postgresql://user:password@host:5432/postgres"

# --- Google Sign-In (free, from Google Cloud Console > APIs & Services > Credentials) ---
GOOGLE_CLIENT_ID="xxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="xxxx"

# --- NextAuth (generate with: npx auth secret) ---
AUTH_SECRET="paste-a-random-32-byte-string-here"

# --- AI insights (free, from https://aistudio.google.com/apikey) ---
# Optional: without this, Hexora still gives rule-based insights.
GEMINI_API_KEY="xxxx"
